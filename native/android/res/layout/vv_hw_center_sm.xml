<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/vv_root" android:layout_width="match_parent" android:layout_height="match_parent">
  <ImageView android:id="@+id/vv_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@null"/>
  <ProgressBar android:id="@+id/vv_twinkle" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="7dp" android:indeterminate="true" android:indeterminateOnly="true" android:minWidth="0dp" android:minHeight="0dp" android:maxWidth="600dp" android:maxHeight="600dp" android:indeterminateDrawable="@drawable/vv_twinkle"/><FrameLayout android:layout_width="88dp" android:layout_height="88dp" android:layout_gravity="center" >
    <ProgressBar android:id="@+id/vv_pulse" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:minWidth="0dp" android:minHeight="0dp" android:maxWidth="600dp" android:maxHeight="600dp" android:indeterminateDrawable="@drawable/vv_pulse" android:indeterminateDuration="2600" android:indeterminateBehavior="cycle"/>
    <ProgressBar android:id="@+id/vv_ring1" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:minWidth="0dp" android:minHeight="0dp" android:maxWidth="600dp" android:maxHeight="600dp" android:indeterminateDrawable="@drawable/vv_rot_a" android:indeterminateDuration="9000"/>
    <ProgressBar android:id="@+id/vv_ring2" android:layout_width="69dp" android:layout_height="69dp" android:layout_gravity="center" android:indeterminate="true" android:indeterminateOnly="true" android:minWidth="0dp" android:minHeight="0dp" android:maxWidth="600dp" android:maxHeight="600dp" android:indeterminateDrawable="@drawable/vv_rot_b" android:indeterminateDuration="14000"/>
  </FrameLayout><TextClock android:id="@+id/vv_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textSize="19sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:shadowColor="#CC000000" android:shadowRadius="8" android:visibility="gone"/>
</FrameLayout>
